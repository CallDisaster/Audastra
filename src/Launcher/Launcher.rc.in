#include <winres.h>
#define IDI_AUDASTRA 101
IDI_AUDASTRA ICON DISCARDABLE "@PROJECT_SOURCE_DIR@/assets/brand/audastra.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "CallDisaster"
            VALUE "FileDescription", "Audastra"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Audastra"
            VALUE "LegalCopyright", "Copyright (c) 2026 CallDisaster"
            VALUE "OriginalFilename", "Audastra.exe"
            VALUE "ProductName", "Audastra"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
