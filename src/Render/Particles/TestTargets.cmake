get_filename_component(_particle_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET war3-particle-tests)
    add_executable(war3-particle-tests "${_particle_root}/tests/ParticleTests.cpp")
    target_link_libraries(war3-particle-tests PRIVATE forge-particle-preview)
    target_include_directories(war3-particle-tests PRIVATE "${WAR3_RENDER_CORE_SOURCE_DIR}/tests")
    if(MSVC)
        target_compile_options(war3-particle-tests PRIVATE /W4 /WX /permissive- /utf-8 /fp:precise)
    else()
        target_compile_options(war3-particle-tests PRIVATE -Wall -Wextra -Werror -ffp-contract=off)
    endif()
    foreach(_p IN ITEMS deterministic emission parsing)
        add_test(NAME render-particles-${_p} COMMAND war3-particle-tests ${_p})
        set_tests_properties(render-particles-${_p} PROPERTIES TIMEOUT 60)
    endforeach()
endif()
