    set(_animation_link War3MapEditor::RenderSupport)
endif()
add_executable(war3-model-animation-tests "${_animation_root}/tests/ModelAnimationTests.cpp")
target_link_libraries(war3-model-animation-tests PRIVATE ${_animation_link} War3RenderCore::SkinInput)
if(MSVC)
    target_compile_options(war3-model-animation-tests PRIVATE /W4 /WX /permissive- /utf-8 /fp:precise)
else()
    target_compile_options(war3-model-animation-tests PRIVATE -Wall -Wextra -Werror -ffp-contract=off)
endif()
foreach(_group IN ITEMS instances geometry submission particle-continuity instance-delta)
    add_test(NAME model-animation-${_group} COMMAND war3-model-animation-tests ${_group})
    set_tests_properties(model-animation-${_group} PROPERTIES TIMEOUT 60)
endforeach()

