# 共享核心只有一个本机上游；路径可覆盖，版本和实际文件必须与锁定清单一致。
get_filename_component(_forge_render_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(WAR3_RENDER_CORE_SOURCE_DIR "${_forge_render_root}/../War3RenderCore" CACHE PATH "共享 War3RenderCore 源码目录")
get_filename_component(WAR3_RENDER_CORE_SOURCE_DIR "${WAR3_RENDER_CORE_SOURCE_DIR}" ABSOLUTE)
if(NOT EXISTS "${WAR3_RENDER_CORE_SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "[WAR3_RENDER_CORE_DIR_MISSING] Shared source directory is missing. 共享核心目录不存在或不完整。请运行 tools/fetch-render-core.ps1 取得锁定版本（默认放在相邻的 War3RenderCore 目录），或设置 WAR3_RENDER_CORE_SOURCE_DIR。")
endif()
set(_render_core_lock "${_forge_render_root}/War3RenderCore.lock.json")
if(NOT EXISTS "${_render_core_lock}")
    message(FATAL_ERROR "[WAR3_RENDER_CORE_LOCK_MISSING] Lock file is missing. 缺少共享核心锁定文件 War3RenderCore.lock.json。")
endif()
file(READ "${_render_core_lock}" _render_lock_json)
string(JSON _render_expected_commit GET "${_render_lock_json}" commit)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${WAR3_RENDER_CORE_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE _render_actual_commit OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _render_git_result ERROR_QUIET)
if(NOT _render_git_result EQUAL 0 OR NOT _render_actual_commit STREQUAL _render_expected_commit)
    message(FATAL_ERROR "[WAR3_RENDER_CORE_COMMIT_MISMATCH] Expected ${_render_expected_commit}, actual ${_render_actual_commit}. 共享核心提交与锁定版本不一致。")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${WAR3_RENDER_CORE_SOURCE_DIR}" status --porcelain --untracked-files=normal
    OUTPUT_VARIABLE _render_git_dirty OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _render_status_result)
if(NOT _render_status_result EQUAL 0 OR NOT _render_git_dirty STREQUAL "")
    message(FATAL_ERROR "[WAR3_RENDER_CORE_DIRTY] Shared checkout is dirty. 共享核心工作树存在未锁定的修改或文件，请先审查并更新锁定版本。")
endif()
string(JSON _render_file_count LENGTH "${_render_lock_json}" files)
math(EXPR _render_last_file "${_render_file_count}-1")
foreach(_render_index RANGE 0 ${_render_last_file})
    string(JSON _render_path GET "${_render_lock_json}" files ${_render_index} path)
    string(JSON _render_expected_hash GET "${_render_lock_json}" files ${_render_index} sha256)
    if(NOT EXISTS "${WAR3_RENDER_CORE_SOURCE_DIR}/${_render_path}")
        message(FATAL_ERROR "[WAR3_RENDER_CORE_FILE_MISSING] ${_render_path}. 共享核心锁定文件缺失。")
    endif()
    file(SHA256 "${WAR3_RENDER_CORE_SOURCE_DIR}/${_render_path}" _render_actual_hash)
    if(NOT _render_actual_hash STREQUAL _render_expected_hash)
        message(FATAL_ERROR "[WAR3_RENDER_CORE_BYTES_MISMATCH] ${_render_path}. 共享核心文件与锁定字节不一致。")
    endif()
endforeach()
