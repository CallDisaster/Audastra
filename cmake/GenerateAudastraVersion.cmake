# VERSION 是程序、CLI 和打包的唯一版本来源；这里只嵌入公开发布配置。
file(READ "${SOURCE_ROOT}/VERSION" AUD_VERSION)
string(STRIP "${AUD_VERSION}" AUD_VERSION)
string(LENGTH "${AUD_VERSION}" AUD_VERSION_LENGTH)
if(AUD_VERSION_LENGTH GREATER 128 OR NOT AUD_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
    message(FATAL_ERROR "VERSION must be a semantic version")
endif()
if(AUD_VERSION MATCHES "-([^+]+)")
    string(REPLACE "." ";" AUD_PRERELEASE_PARTS "${CMAKE_MATCH_1}")
    foreach(AUD_PRERELEASE_PART IN LISTS AUD_PRERELEASE_PARTS)
        if(AUD_PRERELEASE_PART MATCHES "^[0-9]+$" AND NOT AUD_PRERELEASE_PART MATCHES "^(0|[1-9][0-9]*)$")
            message(FATAL_ERROR "Numeric prerelease identifiers cannot have leading zeroes")
        endif()
    endforeach()
endif()
foreach(NAME RELEASE_OWNER RELEASE_REPOSITORY)
    if(NOT "${${NAME}}" MATCHES "^[A-Za-z0-9_.-]+$")
        message(FATAL_ERROR "Invalid public release repository configuration")
    endif()
endforeach()
if(UPDATE_PUBLIC_KEY_HEX)
    string(LENGTH "${UPDATE_PUBLIC_KEY_HEX}" KEY_LENGTH)
    if(NOT KEY_LENGTH EQUAL 64 OR NOT UPDATE_PUBLIC_KEY_HEX MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Ed25519 public key must be 32 bytes in hex")
    endif()
endif()
if(FEEDBACK_ENDPOINT AND NOT FEEDBACK_ENDPOINT MATCHES "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$")
    message(FATAL_ERROR "Feedback endpoint must be HTTPS without credentials, query or fragment")
endif()
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${SOURCE_ROOT}"
    OUTPUT_VARIABLE AUD_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE GIT_RESULT ERROR_QUIET)
if(NOT GIT_RESULT EQUAL 0 OR NOT AUD_COMMIT MATCHES "^[0-9a-f]+$")
    set(AUD_COMMIT "unknown")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
configure_file("${SOURCE_ROOT}/cmake/AudastraVersion.generated.h.in" "${OUTPUT_DIR}/AudastraVersion.generated.h" @ONLY)
configure_file("${SOURCE_ROOT}/cmake/AudastraVersion.generated.json.in" "${OUTPUT_DIR}/audastra-build-version.json" @ONLY)
